# Gemini AI is provisioned via Firebase AI Logic + App Check (no client API key required).

# SUPABASE_URL: Your Supabase project URL (e.g., https://abcdefghijkl.supabase.co).
# Configure via the Secrets panel in AI Studio.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# SUPABASE_ANON_KEY: Public Supabase anonymous/publishable client key for Auth + RLS-protected PostgREST.
# NEVER put SUPABASE_SERVICE_ROLE_KEY or OPENROUTER_API_KEY in .env or client code!
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
